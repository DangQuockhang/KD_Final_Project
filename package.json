{
  "name": "kd-desgin-monorepo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev:store": "npm run dev -w @kd/store",
    "dev:studio": "npm run dev -w @kd/studio",
    "dev:api": "node tools/atlas-launch.mjs dev",
    "db:check": "node tools/atlas-launch.mjs check",
    "db:init": "node tools/atlas-launch.mjs init",
    "db:seed": "node tools/atlas-launch.mjs no-seed",
    "test": "node --test tests/*.test.js",
    "build": "npm run build -w @kd/store && npm run build -w @kd/studio",
    "dev:gallery": "npm run dev -w @kd/store -- --open /gallery-demo.html",
    "db:rollback:accounts": "node tools/atlas-launch.mjs no-rollback",
    "db:rollback:membership": "node tools/atlas-launch.mjs no-rollback",
    "dev:store:lan": "npm run dev -w @kd/store -- --mode lan --host 0.0.0.0 --port 5173 --strictPort",
    "db:admin": "node tools/atlas-launch.mjs admin",
    "atlas:source": "node tools/atlas-launch.mjs source"
  }
}
